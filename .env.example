# Environment Configuration
ENV=main

# General Settings
FRONT_URL=https://frontend.integration.lleidahack.dev/hackeps
BACK_URL=http://localhost:8000/
STATIC_FOLDER=static
CONTACT_MAIL=contacte@lleidahack.dev
LOCAL=false

# Security Settings
# Generate independent random secrets with at least 32 characters.
SECURITY__SECRET_KEY=
SECURITY__ALGORITHM=HS256
SECURITY__EXPIRE_TIME=15
SECURITY__SERVICE_TOKEN=

# Database Settings
DATABASE__URL=postgresql://username:password@host:port/database

# Client Settings
CLIENTS__MAIL_CLIENT__URL=http://mail:8000/


# Required shared rate-limit storage (private network only).
RATE_LIMIT__ENABLED=true
RATE_LIMIT__REDIS_URL=redis://127.0.0.1:6379/0
# Use separate prefixes for main and integration.
RATE_LIMIT__PREFIX=lleidahack:main:limits
# Empty trusts no proxy headers. Set exact proxy IPs only; never *.
FORWARDED_ALLOW_IPS=

# Explicit browser origins, as JSON. Empty allows same-origin requests only.
CORS_ORIGINS=["https://frontend.integration.lleidahack.dev"]

# Official Discord announcements (server-only incoming webhook).
# Run the discord_worker separately; event scope is mandatory.
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_EVENT_ID=

# Apple Wallet: mount private files outside the application/public directories.
# Leave paths blank until provisioned; no Wallet link is exposed by default.
APPLE_WALLET_TEAM_ID=5F659SC689
APPLE_WALLET_PASS_TYPE_ID=pass.cat.lleidahack.tickets
APPLE_WALLET_P12_PATH=
APPLE_WALLET_PASSWORD_FILE=
APPLE_WALLET_WWDR_PATH=
